# Configure privately in Vercel Project Settings → Environment Variables.
# Never place real values in GitHub, frontend code, or public logs.
JWT_SECRET="a-random-secret-at-least-32-characters"
ADMIN_BOOTSTRAP_USERNAME="your-private-admin-username"
ADMIN_BOOTSTRAP_PASSWORD="your-unique-strong-admin-password"
GEMINI_API_KEY="your-private-gemini-key"
GEMINI_MODEL="gemini-2.5-flash"
# Vercel Blob private store: auto-configured on connection to Vercel project
# BLOB_READ_WRITE_TOKEN=...
