# ==============================================================================
# CAMPUS OS — ENVIRONMENT VARIABLES CONFIGURATION (VERCEL & LOCAL)
# ==============================================================================

# 1. GEMINI_API_KEY (Required for Campus AI conversational responses)
# Generate a free or standard key at https://aistudio.google.com/app/apikey
# In Vercel: Project Settings -> Environment Variables -> Add "GEMINI_API_KEY"
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 2. GEMINI_MODEL (Optional)
# The default model used by Campus OS is 'gemini-3.8-flash'
GEMINI_MODEL="gemini-3.8-flash"

# 3. APP_URL (Optional)
# In Vercel, this is automatically configured or you can set your custom domain:
APP_URL="https://your-campus-os.vercel.app"
