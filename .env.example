# Set real values privately in Vercel. Keep this example free of credentials.
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Vercel private Blob credentials. Use the token or OIDC with the store ID.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional comma-separated additional CORS origins. Same-origin works by default.
CAMPUS_ALLOWED_ORIGINS=

# Set these in Vercel to issue a new one-time administrator setup code.
# The code is not an administrator password. Remove it after activation.
CAMPUS_ADMIN_USERNAME=
CAMPUS_ADMIN_SETUP_CODE=
# Optional one-time bcrypt hash for provisioning a temporary administrator password.
# A provisioned account must choose a new private password before reading school data.
CAMPUS_ADMIN_TEMPORARY_PASSWORD_HASH=

# Optional comma-separated SHA-256 digests of exposed administrator passwords.
CAMPUS_REJECTED_ADMIN_PASSWORD_SHA256=
